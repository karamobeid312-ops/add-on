<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Power Studio" Width="1480" Height="880" MinWidth="980" MinHeight="580"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" FontSize="12"
        FontFamily="Segoe UI" Background="#FFF6F8FB" Foreground="#FF1D2733">
  <!-- No event attributes and no x:Class: XamlReader cannot bind them, so
       editor_ui.py wires the events, puts the shared theme in place of the
       THEME marker and the grid columns in place of COLUMNS / VDCOLUMNS. -->
  <Window.Resources>
<!--THEME-->
    <Style x:Key="EditCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="IsEditable" Value="True"/>
      <Setter Property="IsTextSearchEnabled" Value="False"/>
    </Style>
    <Style x:Key="WayRow" TargetType="DataGridRow">
      <Style.Triggers>
        <DataTrigger Binding="{Binding locked}" Value="True">
          <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding sized}" Value="True">
          <Setter Property="Background" Value="{StaticResource OkBgBrush}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <DataTemplate x:Key="VdChip">
      <Border x:Name="chip" Style="{StaticResource Chip}">
        <TextBlock x:Name="txt" Text="{Binding vd}" FontWeight="SemiBold"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding vd_state}" Value="ok">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource OkBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource OkBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding vd_state}" Value="warn">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource WarnBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource WarnBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding vd_state}" Value="bad">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource BadBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource BadBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="StatusChip">
      <Border x:Name="chip" Style="{StaticResource Chip}">
        <TextBlock x:Name="txt" Text="{Binding status}" FontWeight="SemiBold"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding state}" Value="ok">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource OkBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource OkBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding state}" Value="warn">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource WarnBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource WarnBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding state}" Value="bad">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource BadBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource BadBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <Style x:Key="StepNumber" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>
    <Style x:Key="StepNumberText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- header -->
    <Border DockPanel.Dock="Top" Style="{StaticResource HeaderBand}">
      <DockPanel>
        <Border Style="{StaticResource Badge}">
          <TextBlock Text="LV" Style="{StaticResource BadgeText}"/>
        </Border>
        <TextBlock x:Name="ModelText" DockPanel.Dock="Right" Style="{StaticResource HeaderSub}"
                   TextAlignment="Right" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Power Studio" Style="{StaticResource HeaderTitle}"/>
          <TextBlock Text="LV schematic, feeders and voltage drop" Style="{StaticResource HeaderSub}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- footer -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource FooterBar}">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button x:Name="CloseButton" Content="Close" Margin="4,0"/>
          <Button x:Name="AutoSizeButton" Content="Auto Size" Margin="4,0"
                  ToolTip="Size the feeder cable and breaker of every SMDB and DB from its connected load (office XLPE/SWA/PVC table)"/>
          <Button x:Name="ReportButton" Content="Export V.D report" Margin="4,0"
                  ToolTip="Save the voltage drop report as Excel and PDF, with the values shown here"/>
          <Button x:Name="SaveButton" Content="Save to Revit" Margin="4,0"
                  ToolTip="Write the changes and the V.D results into the parameters already in the model"/>
          <Button x:Name="GenerateButton" Content="Draw SLD" Margin="4,0,0,0"
                  Style="{StaticResource PrimaryButton}"
                  ToolTip="Save the changes, then draw the LV schematic in a drafting view"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0"
                   Fill="{StaticResource NoneBrush}"/>
          <TextBlock x:Name="WarningsText" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl x:Name="Steps" Padding="10">
      <!-- 1: boards and ways -->
      <TabItem x:Name="BoardsTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource StepNumber}">
              <TextBlock Text="1" Style="{StaticResource StepNumberText}"/>
            </Border>
            <TextBlock Text="Boards and ways" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" Text="Boards" Style="{StaticResource SectionTitle}"
                         Margin="12,10,12,4"/>
              <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="12,6,12,10"
                         FontSize="11"
                         Text="Green: OK. Amber: check the board. Red: a way is over the V.D limit or has a wrong value."/>
              <TreeView x:Name="BoardsTree" BorderThickness="0" Background="Transparent"/>
            </DockPanel>
          </Border>
          <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"/>

          <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock x:Name="BoardTitle" DockPanel.Dock="Left" FontSize="18"
                         FontWeight="SemiBold" VerticalAlignment="Center"/>
              <Border x:Name="BoardChip" DockPanel.Dock="Left" Style="{StaticResource Chip}"
                      Margin="10,0,0,0">
                <TextBlock x:Name="BoardChipText" FontWeight="SemiBold"/>
              </Border>
              <TextBlock x:Name="BoardWays" DockPanel.Dock="Right" Style="{StaticResource Muted}"
                         VerticalAlignment="Center" TextWrapping="NoWrap"/>
              <TextBlock/>
            </DockPanel>

            <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="4" Margin="0,0,-8,8">
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="CONNECTED LOAD" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiConnected" Style="{StaticResource TileValue}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="DEMAND LOAD" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiDemand" Style="{StaticResource TileValue}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="INCOMER" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiIncomer" Style="{StaticResource TileValue}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="WORST V.D ON ITS WAYS" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiVd" Style="{StaticResource TileValue}"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
              <WrapPanel>
                <TextBlock Text="Incomer" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="IncomerAT" Width="65" Style="{StaticResource EditCombo}"
                          ItemsSource="{DynamicResource ch_incomer_at}" ToolTip="Trip (AT)"/>
                <TextBlock Text="AT" Style="{StaticResource FieldLabel}" Margin="3,0,6,0"/>
                <ComboBox x:Name="IncomerAF" Width="65" Style="{StaticResource EditCombo}"
                          ItemsSource="{DynamicResource ch_incomer_af}" ToolTip="Frame (AF)"/>
                <TextBlock Text="AF" Style="{StaticResource FieldLabel}" Margin="3,0,6,0"/>
                <ComboBox x:Name="IncomerDevice" Width="70" Style="{StaticResource EditCombo}"
                          ItemsSource="{DynamicResource ch_incomer_device}"/>
                <TextBlock Text="Fault level" Style="{StaticResource FieldLabel}" Margin="16,0,4,0"/>
                <ComboBox x:Name="FaultLevel" Width="65" Style="{StaticResource EditCombo}"
                          ItemsSource="{DynamicResource ch_fault_level}"/>
                <TextBlock Text="Ways" Style="{StaticResource FieldLabel}" Margin="16,0,4,0"/>
                <TextBox x:Name="WaysCount" Width="40"/>
                <TextBlock Text="Spares" Style="{StaticResource FieldLabel}" Margin="16,0,4,0"/>
                <ComboBox x:Name="SpareCount" Width="45" Style="{StaticResource EditCombo}"
                          ItemsSource="{DynamicResource ch_spares}"/>
                <TextBlock Text="x" Style="{StaticResource FieldLabel}" Margin="4,0"/>
                <ComboBox x:Name="SpareAT" Width="65" Style="{StaticResource EditCombo}"
                          ItemsSource="{DynamicResource ch_spare_at}" ToolTip="Spare trip (AT)"/>
                <TextBlock Text="AT" Style="{StaticResource FieldLabel}" Margin="3,0,6,0"/>
                <ComboBox x:Name="SpareAF" Width="65" Style="{StaticResource EditCombo}"
                          ItemsSource="{DynamicResource ch_spare_af}" ToolTip="Spare frame (AF)"/>
                <TextBlock Text="AF" Style="{StaticResource FieldLabel}" Margin="3,0,6,0"/>
                <ComboBox x:Name="SpareDevice" Width="70" Style="{StaticResource EditCombo}"
                          ItemsSource="{DynamicResource ch_spare_device}"/>
                <Button x:Name="AddSpare" Content="+ Spare" Margin="8,0,0,0"
                        Style="{StaticResource SmallButton}"/>
                <Button x:Name="RemoveSpare" Content="- Spare" Margin="4,0,0,0"
                        Style="{StaticResource SmallButton}"/>
                <TextBlock Text="Fed from" Style="{StaticResource FieldLabel}" Margin="16,0,4,0"/>
                <ComboBox x:Name="FedBy" Width="140" Style="{StaticResource EditCombo}"
                          ItemsSource="{DynamicResource ch_fed_by}"
                          ToolTip="For a board no circuit in this model feeds (its MDB is in another link): the board feeding it, saved to Fed_By. A name not in this model is drawn as that MDB, built from the boards it feeds."/>
                <TextBlock Text="Transformer V.D %" Style="{StaticResource FieldLabel}"
                           Margin="16,0,4,0"/>
                <TextBox x:Name="TxVd" Width="50"
                         ToolTip="Main boards: the voltage drop of the cable from the transformer, typed by hand (e.g. 0.8). Used instead of working it out from the TX row, and the totals below start from it. Saved to the board's VD Percent."/>
              </WrapPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0"
                    Background="{StaticResource BarBrush}">
              <TextBlock x:Name="PreviewText" FontFamily="Consolas" FontSize="12.5"
                         TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"
                         Text="Click a way to see how it prints on the SLD."/>
            </Border>

            <DataGrid x:Name="WaysGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserSortColumns="False"
                      CanUserReorderColumns="False" SelectionMode="Single"
                      SelectionUnit="Cell" RowStyle="{StaticResource WayRow}"
                      GridLinesVisibility="Horizontal">
              <DataGrid.Columns>
COLUMNS
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </Grid>
      </TabItem>

      <!-- 2: voltage drop of every cable -->
      <TabItem x:Name="VdTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource StepNumber}">
              <TextBlock Text="2" Style="{StaticResource StepNumberText}"/>
            </Border>
            <TextBlock x:Name="VdTabText" Text="Voltage drop" VerticalAlignment="Center"/>
            <Ellipse x:Name="VdDot" Width="8" Height="8" Margin="7,0,0,0"
                     VerticalAlignment="Center" Fill="{StaticResource NoneBrush}"/>
          </StackPanel>
        </TabItem.Header>
        <DockPanel>
          <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="5" Margin="0,0,-8,8">
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="CABLES" Style="{StaticResource TileLabel}"/>
                <TextBlock x:Name="VdCables" Style="{StaticResource TileValue}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="OK" Style="{StaticResource TileLabel}"/>
                <TextBlock x:Name="VdOk" Style="{StaticResource TileValue}"
                           Foreground="{StaticResource OkBrush}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="FAILED" Style="{StaticResource TileLabel}"/>
                <TextBlock x:Name="VdFailed" Style="{StaticResource TileValue}"
                           Foreground="{StaticResource BadBrush}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="INCOMPLETE" Style="{StaticResource TileLabel}"/>
                <TextBlock x:Name="VdIncomplete" Style="{StaticResource TileValue}"
                           Foreground="{StaticResource WarnBrush}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Tile}">
              <StackPanel>
                <TextBlock Text="HIGHEST CUMULATIVE V.D" Style="{StaticResource TileLabel}"/>
                <TextBlock x:Name="VdWorst" Style="{StaticResource TileValue}"/>
                <TextBlock x:Name="VdWorstWhere" Style="{StaticResource TileLabel}"
                           TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,8">
            <StackPanel>
              <TextBlock Text="To fix" Style="{StaticResource SectionTitle}"/>
              <TextBlock x:Name="VdFixes" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}"/>
            </StackPanel>
          </Border>

          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <CheckBox x:Name="VdProblemsOnly" DockPanel.Dock="Right"
                      Content="Show problems only" VerticalAlignment="Center"/>
            <TextBlock Text="Search board or load" Style="{StaticResource FieldLabel}"
                       Margin="0,0,6,0"/>
            <TextBox x:Name="VdSearch" Width="240" HorizontalAlignment="Left"/>
          </DockPanel>

          <DataGrid x:Name="VdGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                    CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single"
                    GridLinesVisibility="Horizontal" CanUserReorderColumns="False">
            <DataGrid.Columns>
VDCOLUMNS
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- 3: settings -->
      <TabItem x:Name="SettingsTab">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <Border Style="{StaticResource StepNumber}">
              <TextBlock Text="3" Style="{StaticResource StepNumberText}"/>
            </Border>
            <TextBlock Text="Settings" VerticalAlignment="Center"/>
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top"
                      Padding="14,12">
                <StackPanel>
                  <TextBlock Text="SLD drawing" Style="{StaticResource SectionTitle}"/>
                  <StackPanel x:Name="SldSettingsPanel"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"
                      Padding="14,12">
                <StackPanel>
                  <TextBlock Text="Voltage drop and report" Style="{StaticResource SectionTitle}"/>
                  <StackPanel x:Name="VdSettingsPanel"/>
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="ApplySettings" Content="Apply settings"
                      Style="{StaticResource PrimaryButton}"/>
              <TextBlock x:Name="SettingsNote" Style="{StaticResource Muted}" Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         Text="Way numbering, voltage and power factor sources, power factor and load basis are read from the model: the window reads it again when they change."/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
