<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FCU Power" Width="1180" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" FontSize="12"
        FontFamily="Segoe UI" Background="#FFF6F8FB" Foreground="#FF1D2733">
  <!-- No event attributes and no x:Class: XamlReader cannot bind them, so
       window_ui.py wires the events and puts the shared theme in place of
       the THEME marker. -->
  <Window.Resources>
<!--THEME-->
    <DataTemplate x:Key="StatusChip">
      <Border x:Name="chip" Style="{StaticResource Chip}">
        <TextBlock x:Name="txt" Text="{Binding status}" FontWeight="SemiBold"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding state}" Value="ok">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource OkBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource OkBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding state}" Value="warn">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource WarnBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource WarnBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding state}" Value="bad">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource BadBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource BadBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="WriteBox">
      <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                IsChecked="{Binding write, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding can}"/>
    </DataTemplate>
    <Style x:Key="StepNumber" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>
    <Style x:Key="StepNumberText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BarLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="14,0,6,0"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,6,0,2"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- header -->
    <Border DockPanel.Dock="Top" Style="{StaticResource HeaderBand}">
      <DockPanel>
        <Border Style="{StaticResource Badge}">
          <TextBlock Text="FCU" Style="{StaticResource BadgeText}"/>
        </Border>
        <TextBlock x:Name="ModelText" DockPanel.Dock="Right" Style="{StaticResource HeaderSub}"
                   TextAlignment="Right" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="FCU Power" Style="{StaticResource HeaderTitle}"/>
          <TextBlock Text="Real_Power_W of the FCUs from the mechanical schedule (tag = Comments of the nearest FCU in the mechanical link)"
                     Style="{StaticResource HeaderSub}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- footer: status and Close; each step has its own button -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource FooterBar}">
      <DockPanel LastChildFill="True">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Margin="4,0,0,0"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0"
                   Fill="{StaticResource NoneBrush}"/>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- one bar: the schedule, the floor, the setup -->
    <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <Button x:Name="SetupButton" DockPanel.Dock="Right" Content="Setup..." Margin="14,0,0,0"
                Style="{StaticResource SmallButton}"
                ToolTip="Schedule sheets and columns, FCU families, the parameter holding the tag (picked by the tool)"/>
        <ComboBox x:Name="FloorCombo" DockPanel.Dock="Right" Width="150"
                  ToolTip="Everything below is for this floor (the active view's level at first)"/>
        <TextBlock DockPanel.Dock="Right" Text="Floor" Style="{StaticResource BarLabel}"/>
        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse..."
                Style="{StaticResource SmallButton}" Margin="6,0,0,0"/>
        <TextBlock DockPanel.Dock="Left" Text="Schedule" Style="{StaticResource BarLabel}" Margin="0,0,6,0"/>
        <TextBox x:Name="FileText" IsReadOnly="True" VerticalContentAlignment="Center"/>
      </DockPanel>
    </Border>

    <Grid>
      <TabControl x:Name="Steps" Padding="10">
        <!-- 1: sockets for the linked FCUs that have none -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="1" Style="{StaticResource StepNumberText}"/>
              </Border>
              <TextBlock x:Name="MissingTabText" Text="Missing sockets" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="FCUs of the mechanical link on this floor that are in the schedule and have no socket within 3 m. Each gets a socket on the slab underside above it."/>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add missing sockets"
                      Style="{StaticResource PrimaryButton}"
                      ToolTip="Place a socket on the slab above each FCU listed"/>
              <TextBlock Text="Socket type" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="SocketTypeCombo" Width="300" HorizontalAlignment="Left"
                        ToolTip="Face-based or level-based types of the ticked families"/>
            </DockPanel>
            <DataGrid x:Name="MissingGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" IsReadOnly="True" SelectionMode="Single"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Disabled">
              <DataGrid.Columns>
                <DataGridTextColumn Header="FCU tag" Binding="{Binding tag}" Width="2*"/>
                <DataGridTextColumn Header="Schedule space" Binding="{Binding space}" Width="3*"/>
                <DataGridTextColumn Header="Power W" Binding="{Binding new}" Width="70"/>
                <DataGridTemplateColumn Header="Status" Width="3*" CellTemplate="{StaticResource StatusChip}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- 2: Real_Power_W -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="2" Style="{StaticResource StepNumberText}"/>
              </Border>
              <TextBlock x:Name="PowerTabText" Text="Power" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="5" Margin="0,0,-8,8">
              <Border Style="{StaticResource Tile}" ToolTip="FCUs that get a new Real_Power_W">
                <StackPanel>
                  <TextBlock Text="TO WRITE" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiWrite" Style="{StaticResource TileValue}" Foreground="{StaticResource OkBrush}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}" ToolTip="FCUs that already have the schedule's power">
                <StackPanel>
                  <TextBlock Text="ALREADY SET" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiSame" Style="{StaticResource TileValue}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}" ToolTip="Matched on the tag, but the room or the count does not agree">
                <StackPanel>
                  <TextBlock Text="CHECK" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiCheck" Style="{StaticResource TileValue}" Foreground="{StaticResource WarnBrush}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}" ToolTip="Not written: no tag, tag not in the schedule, rows that differ, no parameter">
                <StackPanel>
                  <TextBlock Text="PROBLEMS" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiBad" Style="{StaticResource TileValue}" Foreground="{StaticResource BadBrush}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}" ToolTip="Schedule tags with no FCU in the model">
                <StackPanel>
                  <TextBlock Text="NOT IN MODEL" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiUnused" Style="{StaticResource TileValue}"/>
                </StackPanel>
              </Border>
            </UniformGrid>

            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button x:Name="WriteButton" DockPanel.Dock="Right" Content="Write to Revit"
                      Style="{StaticResource PrimaryButton}"
                      ToolTip="Write Real_Power_W on the ticked FCUs of this floor (only the parameter already in the model)"/>
              <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                         Text="Untick a row to leave that FCU as it is."/>
            </DockPanel>

            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="Show" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="ShowCombo" Width="230"/>
              <TextBlock Text="Search" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="14,0,6,0"/>
              <TextBox x:Name="SearchText" Width="200" VerticalContentAlignment="Center"/>
              <TextBlock/>
            </DockPanel>

            <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" SelectionMode="Single" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal" CanUserReorderColumns="False"
                      HeadersVisibility="Column" HorizontalScrollBarVisibility="Disabled">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Write" Width="46" CellTemplate="{StaticResource WriteBox}"/>
                <DataGridTextColumn Header="FCU tag" Binding="{Binding tag}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Room" Binding="{Binding room}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Now W" Binding="{Binding now}" Width="62" IsReadOnly="True"/>
                <DataGridTextColumn Header="New W" Binding="{Binding new}" Width="62" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Status" Width="3*" IsReadOnly="True"
                                        CellTemplate="{StaticResource StatusChip}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- 3: circuits, wires and tags -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="3" Style="{StaticResource StepNumberText}"/>
              </Border>
              <TextBlock x:Name="CircuitTabText" Text="Circuit + wire" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBlock Text="Panel" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="PanelCombo" Width="200" IsEditable="True" IsTextSearchEnabled="True"/>
              <TextBlock Text="Wire type" Style="{StaticResource BarLabel}"/>
              <ComboBox x:Name="WireTypeCombo" Width="200"/>
              <TextBlock Text="Wire tag" Style="{StaticResource BarLabel}"/>
              <ComboBox x:Name="WireTagCombo" Width="260"/>
            </WrapPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button x:Name="TickSelectedButton" DockPanel.Dock="Left" Content="Tick selected"
                      Style="{StaticResource SmallButton}" Margin="0,0,6,0"
                      ToolTip="Select rows with Shift or Ctrl + click, then tick them here (or press Space)"/>
              <Button x:Name="UntickSelectedButton" DockPanel.Dock="Left" Content="Untick selected"
                      Style="{StaticResource SmallButton}" Margin="0,0,14,0"/>
              <Button x:Name="TickAllButton" DockPanel.Dock="Left" Content="Tick all"
                      Style="{StaticResource SmallButton}" Margin="0,0,6,0"/>
              <Button x:Name="TickNoneButton" DockPanel.Dock="Left" Content="Untick all"
                      Style="{StaticResource SmallButton}" Margin="0,0,12,0"/>
              <Button x:Name="CircuitButton" DockPanel.Dock="Right" Content="Circuit + wire"
                      Style="{StaticResource PrimaryButton}"
                      ToolTip="Each outlet listed gets its own circuit on the panel, a home-run wire towards it and a wire tag"/>
              <TextBlock x:Name="CircuitInfo" Style="{StaticResource Muted}" VerticalAlignment="Center"
                         TextWrapping="Wrap" Margin="0,0,12,0"/>
            </DockPanel>
            <DataGrid x:Name="CircuitGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" SelectionMode="Extended" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                      HorizontalScrollBarVisibility="Disabled">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Do" Width="46" CellTemplate="{StaticResource WriteBox}"/>
                <DataGridTextColumn Header="FCU tag" Binding="{Binding tag}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Room" Binding="{Binding room}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Panel now" Binding="{Binding space}" Width="2*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Will do" Width="3*" IsReadOnly="True"
                                        CellTemplate="{StaticResource StatusChip}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
      </TabControl>

      <!-- setup: what the tool picks by itself, over the steps -->
      <Grid x:Name="SetupPanel" Visibility="Collapsed" Background="#99F6F8FB">
        <Border Style="{StaticResource Card}" Margin="40,20" MaxWidth="1000">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <Button x:Name="SetupDone" DockPanel.Dock="Right" Content="Done"
                      Style="{StaticResource PrimaryButton}"/>
              <TextBlock Text="Setup (picked by the tool; change only if something is wrong)"
                         Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="Schedule sheets (tick the ones to use)" Style="{StaticResource FieldLabel}"/>
                <StackPanel DockPanel.Dock="Bottom">
                  <TextBlock x:Name="SheetTitle" Style="{StaticResource FieldLabel}" FontWeight="SemiBold"
                             Foreground="{StaticResource TextBrush}"/>
                  <TextBlock Text="FCU tag column" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="TagCombo"/>
                  <TextBlock Text="Served space / room column" Style="{StaticResource FieldLabel}"/>
                  <ComboBox x:Name="RoomCombo"/>
                  <TextBlock Text="Electrical power column" Style="{StaticResource FieldLabel}"/>
                  <DockPanel>
                    <ComboBox x:Name="UnitCombo" DockPanel.Dock="Right" Width="60" Margin="6,0,0,0"
                              ToolTip="Unit of the power column: kW is multiplied by 1000"/>
                    <ComboBox x:Name="PowerCombo"/>
                  </DockPanel>
                  <TextBlock x:Name="SheetInfo" Style="{StaticResource Muted}" FontSize="11"
                             Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ListBox x:Name="SheetList" BorderThickness="0" Background="Transparent" MinHeight="60"/>
              </DockPanel>
              <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="Parameter holding the FCU tag" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="TagParamCombo" DockPanel.Dock="Top" Margin="0,0,0,6"
                          ToolTip="Picked by itself: the text parameter whose values match the most schedule tags"/>
                <TextBlock DockPanel.Dock="Top" Text="FCU socket families in the model" Style="{StaticResource FieldLabel}"/>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" FontSize="11"
                           Margin="0,6,0,0" TextWrapping="Wrap"
                           Text="Families with Real_Power_W, or with FCU in their name. Names with FCU are ticked at first."/>
                <ListBox x:Name="FamilyList" BorderThickness="0" Background="Transparent"/>
              </DockPanel>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
