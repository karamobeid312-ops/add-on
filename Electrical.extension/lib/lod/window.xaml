<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LOD Studio" Width="1180" Height="760" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" FontSize="12"
        FontFamily="Segoe UI" Background="#FFF6F8FB" Foreground="#FF1D2733">
  <!-- No event attributes and no x:Class: XamlReader cannot bind them, so
       window_ui.py wires the events and puts the shared theme in place of
       the THEME marker. -->
  <Window.Resources>
<!--THEME-->
    <DataTemplate x:Key="StatusChip">
      <Border x:Name="chip" Style="{StaticResource Chip}">
        <TextBlock x:Name="txt" Text="{Binding status}" FontWeight="SemiBold"/>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding state}" Value="ok">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource OkBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource OkBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding state}" Value="warn">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource WarnBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource WarnBrush}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding state}" Value="bad">
          <Setter TargetName="chip" Property="Background" Value="{StaticResource BadBgBrush}"/>
          <Setter TargetName="txt" Property="Foreground" Value="{StaticResource BadBrush}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="DoBox">
      <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                IsChecked="{Binding do, UpdateSourceTrigger=PropertyChanged}"
                IsEnabled="{Binding can}"/>
    </DataTemplate>
    <Style x:Key="StepNumber" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Width" Value="18"/>
      <Setter Property="Height" Value="18"/>
      <Setter Property="Margin" Value="0,0,7,0"/>
    </Style>
    <Style x:Key="StepNumberText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="BarLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="14,0,6,0"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Margin" Value="0,8,0,2"/>
    </Style>
    <Style x:Key="Grid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="SelectionMode" Value="Extended"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
      <Setter Property="CanUserReorderColumns" Value="False"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- header -->
    <Border DockPanel.Dock="Top" Style="{StaticResource HeaderBand}">
      <DockPanel>
        <Border Style="{StaticResource Badge}">
          <TextBlock Text="LOD" Style="{StaticResource BadgeText}"/>
        </Border>
        <TextBlock x:Name="ModelText" DockPanel.Dock="Right" Style="{StaticResource HeaderSub}"
                   TextAlignment="Right" VerticalAlignment="Center"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="LOD Studio" Style="{StaticResource HeaderTitle}"/>
          <TextBlock Text="Sheets, views and key plans kept in step with the List of Deliverables"
                     Style="{StaticResource HeaderSub}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- footer: status, tick buttons and Close; each tab has its own action button -->
    <Border DockPanel.Dock="Bottom" Style="{StaticResource FooterBar}">
      <DockPanel LastChildFill="True">
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="Close" Margin="4,0,0,0"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
          <Ellipse x:Name="StatusDot" Width="10" Height="10" Margin="0,0,8,0"
                   Fill="{StaticResource NoneBrush}"/>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- one bar: the LOD file, search, setup -->
    <Border DockPanel.Dock="Top" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8">
      <DockPanel>
        <Button x:Name="SetupButton" DockPanel.Dock="Right" Content="Setup..." Margin="14,0,0,0"
                Style="{StaticResource SmallButton}"
                ToolTip="Title prefix, revision and area parameters, key plan rules"/>
        <TextBox x:Name="SearchText" DockPanel.Dock="Right" Width="200"
                 ToolTip="Show only the rows with this text"/>
        <TextBlock DockPanel.Dock="Right" Text="Search" Style="{StaticResource BarLabel}"/>
        <Button x:Name="ReloadButton" DockPanel.Dock="Right" Content="Reload"
                Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                ToolTip="Read the LOD and the model again"/>
        <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse..."
                Style="{StaticResource SmallButton}" Margin="6,0,0,0"/>
        <TextBlock DockPanel.Dock="Left" Text="LOD" Style="{StaticResource BarLabel}" Margin="0,0,6,0"/>
        <TextBox x:Name="FileText" IsReadOnly="True"/>
      </DockPanel>
    </Border>

    <Grid>
      <TabControl x:Name="Steps" Padding="10">
        <!-- 1: create sheets -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="1" Style="{StaticResource StepNumberText}"/>
              </Border>
              <TextBlock x:Name="CreateTabText" Text="Create sheets" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8"
                       Text="LOD drawings with no sheet in this model. Untick the ones to skip."/>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button x:Name="CreateButton" DockPanel.Dock="Right" Content="Create sheets"
                      Style="{StaticResource PrimaryButton}"/>
              <CheckBox x:Name="CreateKeyplans" DockPanel.Dock="Right" Margin="0,0,14,0"
                        Content="Set their key plans" IsChecked="True"/>
              <CheckBox x:Name="CreateViews" DockPanel.Dock="Right" Margin="0,0,14,0"
                        Content="Place their views" IsChecked="True"/>
              <TextBlock Text="Title block" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="TitleBlockCombo" Width="320" HorizontalAlignment="Left"/>
            </DockPanel>
            <DataGrid x:Name="CreateGrid" Style="{StaticResource Grid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Do" Width="40" CellTemplate="{StaticResource DoBox}"/>
                <DataGridTextColumn Header="Number" Binding="{Binding number}" Width="190" IsReadOnly="True"/>
                <DataGridTextColumn Header="Sheet name" Binding="{Binding c1}" Width="5*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Rev." Binding="{Binding c2}" Width="50" IsReadOnly="True"/>
                <DataGridTextColumn Header="Area" Binding="{Binding c3}" Width="1.3*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Status" Width="1.6*" IsReadOnly="True"
                                        CellTemplate="{StaticResource StatusChip}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- 2: compare and sync -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="2" Style="{StaticResource StepNumberText}"/>
              </Border>
              <TextBlock x:Name="CompareTabText" Text="Compare + sync" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <UniformGrid DockPanel.Dock="Top" Rows="1" Columns="5" Margin="0,0,-8,8">
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="LOD DRAWINGS" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiDrawings" Style="{StaticResource TileValue}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="MATCHING SHEETS" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiMatched" Style="{StaticResource TileValue}" Foreground="{StaticResource OkBrush}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}" ToolTip="Names, revisions or areas that differ from the LOD">
                <StackPanel>
                  <TextBlock Text="TO SYNC" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiChanges" Style="{StaticResource TileValue}" Foreground="{StaticResource WarnBrush}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="NOT IN REVIT" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiMissing" Style="{StaticResource TileValue}" Foreground="{StaticResource BadBrush}"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Tile}">
                <StackPanel>
                  <TextBlock Text="NOT IN THE LOD" Style="{StaticResource TileLabel}"/>
                  <TextBlock x:Name="KpiExtra" Style="{StaticResource TileValue}"/>
                </StackPanel>
              </Border>
            </UniformGrid>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button x:Name="SyncButton" DockPanel.Dock="Right" Content="Sync ticked to Revit"
                      Style="{StaticResource PrimaryButton}"
                      ToolTip="Write the LOD's names, revisions and areas on the ticked sheets (one undo)"/>
              <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                         Text="Ticked rows take the LOD value. The other rows are for information."/>
            </DockPanel>
            <DataGrid x:Name="CompareGrid" Style="{StaticResource Grid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Do" Width="40" CellTemplate="{StaticResource DoBox}"/>
                <DataGridTextColumn Header="Number" Binding="{Binding number}" Width="190" IsReadOnly="True"/>
                <DataGridTextColumn Header="What" Binding="{Binding c1}" Width="110" IsReadOnly="True"/>
                <DataGridTextColumn Header="In Revit" Binding="{Binding c2}" Width="3*" IsReadOnly="True"/>
                <DataGridTextColumn Header="In the LOD" Binding="{Binding c3}" Width="3*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Status" Width="1.5*" IsReadOnly="True"
                                        CellTemplate="{StaticResource StatusChip}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- 3: views on sheets -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="3" Style="{StaticResource StepNumberText}"/>
              </Border>
              <TextBlock x:Name="ViewsTabText" Text="Place views" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8"
                       Text="Each sheet takes the view named like it (case, dashes and leading zeros do not matter). The view goes in the middle of the title block."/>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button x:Name="PlaceButton" DockPanel.Dock="Right" Content="Place views"
                      Style="{StaticResource PrimaryButton}"/>
              <TextBlock Text="Show" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="ViewsShowCombo" Width="200" HorizontalAlignment="Left"/>
            </DockPanel>
            <DataGrid x:Name="ViewsGrid" Style="{StaticResource Grid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Do" Width="40" CellTemplate="{StaticResource DoBox}"/>
                <DataGridTextColumn Header="Number" Binding="{Binding number}" Width="190" IsReadOnly="True"/>
                <DataGridTextColumn Header="Sheet" Binding="{Binding c1}" Width="3*" IsReadOnly="True"/>
                <DataGridTextColumn Header="View" Binding="{Binding c2}" Width="3*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Status" Width="200" IsReadOnly="True"
                                        CellTemplate="{StaticResource StatusChip}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- 4: key plans -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="4" Style="{StaticResource StepNumberText}"/>
              </Border>
              <TextBlock x:Name="KeyTabText" Text="Key plans" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,8"
                       Text="The key plan picture each sheet's name asks for (Tower 2 = Building 2, Part 1 = GF &amp; FF Part 01...). Rules in Setup."/>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button x:Name="KeyButton" DockPanel.Dock="Right" Content="Set key plans"
                      Style="{StaticResource PrimaryButton}"/>
              <TextBlock Text="Show" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
              <ComboBox x:Name="KeyShowCombo" Width="200" HorizontalAlignment="Left"/>
            </DockPanel>
            <DataGrid x:Name="KeyGrid" Style="{StaticResource Grid}">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Do" Width="40" CellTemplate="{StaticResource DoBox}"/>
                <DataGridTextColumn Header="Number" Binding="{Binding number}" Width="190" IsReadOnly="True"/>
                <DataGridTextColumn Header="Sheet" Binding="{Binding c1}" Width="3*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Key plan on" Binding="{Binding c2}" Width="1.4*" IsReadOnly="True"/>
                <DataGridTemplateColumn Header="Status" Width="1.8*" IsReadOnly="True"
                                        CellTemplate="{StaticResource StatusChip}"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- 5: export -->
        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <Border Style="{StaticResource StepNumber}">
                <TextBlock Text="5" Style="{StaticResource StepNumberText}"/>
              </Border>
              <TextBlock Text="Export LOD" VerticalAlignment="Center"/>
            </StackPanel>
          </TabItem.Header>
          <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
              <RadioButton x:Name="ExportUpdate" IsChecked="True" Margin="0,0,0,6"
                           Content="Update the LOD from Revit: keep its order, groups and stage ticks; names and revisions from the sheets"/>
              <RadioButton x:Name="ExportNew"
                           Content="New LOD from the Revit sheets only, listed by area"/>
            </StackPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="Export LOD..."
                      Style="{StaticResource PrimaryButton}"
                      ToolTip="Save a new .xlsx (the LOD it was made from is never overwritten)"/>
              <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center"
                         Text="What the exported LOD will mark:"/>
            </DockPanel>
            <DataGrid x:Name="ExportGrid" Style="{StaticResource Grid}">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Status in the export" Binding="{Binding c1}" Width="3*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Drawings" Binding="{Binding number}" Width="*" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>
      </TabControl>

      <!-- setup: rarely changed, over the tabs -->
      <Grid x:Name="SetupPanel" Visibility="Collapsed" Background="#99F6F8FB">
        <Border Style="{StaticResource Card}" Margin="40,20" MaxWidth="1000">
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
              <Button x:Name="SetupDone" DockPanel.Dock="Right" Content="Done"
                      Style="{StaticResource PrimaryButton}"/>
              <TextBlock Text="Setup" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
            </DockPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.4*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="Title prefix left out of the sheet names (e.g. KEZAD Two Building - )" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="PrefixText"/>
                <TextBlock Text="Sheet parameter holding the LOD revision (empty: not used)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="RevText"/>
                <TextBlock Text="Sheet parameter for the area (empty: not used)" Style="{StaticResource FieldLabel}"/>
                <TextBox x:Name="AreaText"/>
                <TextBlock Text="Key plan rules" Style="{StaticResource FieldLabel}"/>
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="RulesButton" Content="Edit in Notepad..." Style="{StaticResource SmallButton}" Margin="0,0,6,0"/>
                  <Button x:Name="RulesResetButton" Content="Back to the defaults" Style="{StaticResource SmallButton}"/>
                </StackPanel>
                <TextBlock x:Name="RulesInfo" Style="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
              </StackPanel>
              <DockPanel Grid.Column="2">
                <DockPanel DockPanel.Dock="Top">
                  <Button x:Name="ParamsButton" DockPanel.Dock="Right" Content="Read this sheet"
                          Style="{StaticResource SmallButton}"
                          ToolTip="The parameters of the open sheet's title block and families"/>
                  <TextBlock Text="Parameters of the open sheet (to name key plan rules)" Style="{StaticResource FieldLabel}"/>
                </DockPanel>
                <DataGrid x:Name="ParamsGrid" Style="{StaticResource Grid}" Margin="0,6,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Parameter" Binding="{Binding c1}" Width="2*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Kind" Binding="{Binding c2}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Value" Binding="{Binding c3}" Width="2*" IsReadOnly="True"/>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Grid>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
